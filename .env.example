# ─────────────────────────────────────────────────────────────────────────────
# Palabria · variables de entorno (copia este archivo a .env.local)
# Ningún valor de este archivo se envía al navegador, salvo los NEXT_PUBLIC_* del final.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (Supabase, Neon, RDS o local). Si se deja vacío, en desarrollo se
# usa PostgreSQL embebido (PGlite) guardado en PGLITE_DIR.
# Supabase: Project Settings → Database → Connection string (URI). Para un
# servidor Node de larga duración usa la conexión directa o el pooler en modo
# sesión (puerto 5432).
DATABASE_URL=
# DATABASE_POOL_SIZE=10
# PGLITE_DIR=.data/pglite

# Aplicar migraciones automáticamente al arrancar (por defecto: true).
# AUTO_MIGRATE=true

# Secreto para firmar la cookie de identidad anónima (mínimo 32 caracteres).
# OBLIGATORIO en producción. Genera uno con: openssl rand -base64 48
APP_SECRET=

# Semilla secreta de la selección diaria de preguntas (cambiarla altera los
# desafíos futuros aún no publicados; los ya publicados no cambian).
CHALLENGE_SALT=

# URL pública (se añade a los resultados compartidos). Ej.: https://palabria.example.com
PUBLIC_APP_URL=

# Cookie Secure: por defecto activada en producción. Ponla a false solo para
# probar la build de producción por HTTP en local.
# COOKIE_SECURE=true

# ── Reglas de tiempo (segundos). Se fijan al empezar cada partida. ──
# ROSCO_SECONDS=180                    # Solo El Rosco (individual)
# PROGRAM_ROSCO_BASE_SECONDS=120       # Rosco final del programa (+ segundos ganados)
# DUEL_ROSCO_SECONDS=180               # Reloj de cada jugador en el duelo «Solo El Rosco»
# DUEL_PROGRAM_ROSCO_BASE_SECONDS=120  # Rosco final del duelo de programa completo
# DUEL_RECONNECT_GRACE_SECONDS=45      # Margen de reconexión antes de declarar abandono
# ROOM_WAITING_TTL_SECONDS=10800       # Caducidad de una sala sin empezar (máx. hasta medianoche)

# Límite de acciones de juego por jugador cada 10 s (protección contra ráfagas).
# ACTION_RATE_LIMIT=60

# Carpeta con ediciones manuales de desafíos (content/overrides/AAAA-MM-DD.json).
# CHALLENGE_OVERRIDES_DIR=content/overrides

# ── Versión GitHub Pages + Supabase (exportación estática, `npm run build:pages`) ──
# Valores públicos: se incrustan en el JavaScript del navegador.
# NEXT_PUBLIC_BASE_PATH=/Palabria
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# NEXT_PUBLIC_API_URL=https://<ref>.supabase.co/functions/v1/api
# Solo en local, contra `npm run api:dev`: identidades simuladas sin Supabase.
# NEXT_PUBLIC_DEV_AUTH=1
